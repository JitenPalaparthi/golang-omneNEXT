# App
PORT=8085

# Database (either set DATABASE_URL or individual DB_* vars)
# Example:
# postgres://postgres:postgres@localhost:5432/usersdb?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/usersdb?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=usersdb

# CORS origin for local Vite
CORS_ORIGIN=http://localhost:5173
